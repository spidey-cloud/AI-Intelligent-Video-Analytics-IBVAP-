# IBVAP environment configuration
IBVAP_HOST=0.0.0.0
IBVAP_PORT=8000
IBVAP_SECRET=change-me-in-production
IBVAP_TOKEN_TTL_HOURS=12

# storage
IBVAP_DB=data/ibvap.db
IBVAP_MEDIA=data/media

# detection
IBVAP_DETECTOR=auto          # auto | ssd | yolo | sim
IBVAP_CONF=0.4
IBVAP_FRAME_WIDTH=640
IBVAP_SSD_WEIGHTS=models/mobilenet_iter_73000.caffemodel
IBVAP_SSD_PROTOTXT=models/object_detection_caffe.prototxt
IBVAP_YOLO_MODEL=models/yolov8n.pt
IBVAP_CPU_THREADS=2

# events
IBVAP_CLIP_SECONDS=20
IBVAP_RING_FPS=2
IBVAP_LOITER_SECONDS=15
IBVAP_INTRUSION_COOLDOWN=25
IBVAP_TRACK_EXPIRE=1.6
IBVAP_EVENT_MAX_AGE=90
IBVAP_EVENT_STABLE_GAP=3

# live view
IBVAP_MJPEG_INTERVAL=0.7
